---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import { getDictionary } from '../../i18n';
import { getLegal } from '../../i18n/legal';

const locale = 'nl';
const dict = getDictionary(locale);
const doc = getLegal(locale).terms;
---

<BaseLayout path="/terms" title={`${doc.title} · ${dict.meta.siteName}`} description={doc.description}>
  <LegalDoc doc={doc} />
</BaseLayout>
