---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import CookieConsent from '../components/react/CookieConsent';
import ConsentScriptLoader from '../components/react/ConsentScriptLoader';
import { getDictionary, isActiveLocale } from '../i18n';
import { getAppUrl, localizePath } from '../lib/env';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const locale = Astro.currentLocale ?? 'en';
const dict = getDictionary(locale);
const {
  title = dict.meta.title,
  description = dict.meta.description,
  path = '/',
  noindex = false,
} = Astro.props;
const appUrl = getAppUrl();
const loginHref =
  appUrl.startsWith('http') ? appUrl : localizePath(locale, appUrl);
const active = isActiveLocale(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!active ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : noindex ? (
      <meta name="robots" content="noindex" />
    ) : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      locale={locale}
      path={path}
      siteName={dict.meta.siteName}
      ogLocale={dict.meta.ogLocale}
      noindex={noindex || !active}
      active={active}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    {
      active ? (
        <Header
          locale={locale}
          dict={dict}
          loginHref={loginHref}
        />
      ) : null
    }
    <main class="flex-1">
      <slot />
    </main>
    {active ? <Footer locale={locale} dict={dict} /> : null}
    {
      active ? (
        <>
          <CookieConsent client:load copy={dict.consent} />
          <ConsentScriptLoader client:load />
        </>
      ) : null
    }
  </body>
</html>
