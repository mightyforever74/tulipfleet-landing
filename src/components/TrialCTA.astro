---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';

interface Props {
  dict: Dictionary;
  locale: string;
}

const { dict, locale } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="glass relative overflow-hidden rounded-3xl px-6 py-12 text-center sm:px-12">
    <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-accent/20 blur-3xl" />
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{dict.trialCta.title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-slate-muted">{dict.trialCta.body}</p>
    <a href={localizePath(locale, '/signup')} class="btn-primary mt-8 inline-flex">
      {dict.trialCta.button}
    </a>
  </div>
</section>
