---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';

interface Props {
  dict: Dictionary;
  locale: string;
}

const { dict, locale } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:py-32">
  <div class="glass relative overflow-hidden rounded-3xl px-6 py-16 text-center sm:px-12">
    <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-accent/20 blur-3xl" />
    <h2 class="font-display text-3xl font-bold tracking-tight text-offwhite sm:text-4xl lg:text-5xl">{dict.trialCta.title}</h2>
    <p class="mx-auto mt-6 max-w-[65ch] text-lg font-medium leading-relaxed text-navy-fog lg:text-xl">{dict.trialCta.body}</p>
    <a href={localizePath(locale, '/signup')} class="btn-primary mt-10 inline-flex whitespace-nowrap">
      {dict.trialCta.button}
    </a>
  </div>
</section>
