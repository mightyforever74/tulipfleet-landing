---
import type { Dictionary } from '../i18n';
import { storeLinks } from '../config/stores';
import PhoneCarousel from './react/PhoneCarousel';

interface Props {
  dict: Dictionary;
  locale: string;
}

const { dict, locale } = Astro.props;
const m = dict.mobileBridge;
---

<section id="mobile" class="relative overflow-hidden py-24 lg:py-32">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_left,var(--color-accent-dim),transparent_50%)]" />

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="order-2 lg:order-1">
      <PhoneCarousel client:visible locale={locale} />
    </div>

    <div class="order-1 lg:order-2">
      <span class="badge-live !normal-case">{m.liveBadge}</span>
      <h2 class="mt-6 font-display text-3xl font-bold tracking-tight text-offwhite sm:text-4xl lg:text-5xl">
        {m.title}
      </h2>
      <p class="mt-6 text-lg font-medium leading-relaxed text-navy-fog lg:text-xl">
        {m.subtitle}
      </p>
      <p class="mt-5 max-w-[65ch] text-base font-medium leading-relaxed text-navy-fog lg:text-lg">
        {m.body}
      </p>

      <p class="mt-10 font-display text-sm font-semibold uppercase tracking-wide text-accent-soft">
        {m.cycleLabel}
      </p>
      <ol class="mt-4 space-y-3">
        {
          m.steps.map((step, i) => (
            <li class="flex items-start gap-3 text-sm font-medium text-navy-fog sm:text-base">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent/20 font-display text-xs font-bold text-accent-soft">
                {i + 1}
              </span>
              <span>
                {step}
                {i < m.steps.length - 1 ? (
                  <span class="ml-2 hidden text-accent-soft/60 sm:inline" aria-hidden="true">
                    →
                  </span>
                ) : null}
              </span>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={storeLinks.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center rounded-xl border border-navy-line bg-navy-ink px-3 transition hover:border-accent/40"
          aria-label={m.appStore}
          title={m.appStore}
        >
          <svg width="120" height="40" viewBox="0 0 120 40" aria-hidden="true">
            <rect width="120" height="40" rx="8" fill="currentColor" class="text-navy-ink"></rect>
            <path fill="currentColor" class="text-offwhite" d="M24.5 20.2c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.9-3.5.9-.7 0-1.9-.8-3.1-.8-1.6 0-3.1.9-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.6.8 1.1 1.7 2.4 3 2.4 1.2 0 1.6-.8 3.1-.8s1.8.8 3.1.8 2.1-1.2 2.9-2.4c.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.8zm-2.3-6.7c.6-.8 1.1-1.9 1-3-.9 0-2 .6-2.6 1.4-.6.7-1.1 1.9-1 2.9 1.1.1 2.1-.5 2.6-1.3z"></path>
            <text x="42" y="15" fill="currentColor" class="text-offwhite" font-size="7" font-family="system-ui,sans-serif">Download on the</text>
            <text x="42" y="28" fill="currentColor" class="text-offwhite" font-size="12" font-weight="600" font-family="system-ui,sans-serif">App Store</text>
          </svg>
        </a>
        <span
          class="inline-flex h-11 cursor-default items-center rounded-xl border border-navy-line bg-navy-ink px-3 opacity-60"
          role="img"
          aria-label={m.playStoreSoon}
          title={m.playStoreSoon}
        >
          <svg width="135" height="40" viewBox="0 0 135 40" aria-hidden="true">
            <rect width="135" height="40" rx="8" fill="currentColor" class="text-navy-ink"></rect>
            <path fill="#EA4335" d="M12 10.5l8.5 8.5L12 27.5V10.5z"></path>
            <path fill="#FBBC04" d="M12 27.5l8.5-8.5 3.2 3.2L12 30.8v-3.3z"></path>
            <path fill="#4285F4" d="M26.5 18.2l-2.8-1.6-8.5 8.5 3.2 3.2 8.1-4.6c.9-.5.9-1.9 0-2.5z"></path>
            <path fill="#34A853" d="M12 10.5l11.7 6.7-3.2 1.8L12 10.5z"></path>
            <text x="36" y="15" fill="currentColor" class="text-offwhite" font-size="7" font-family="system-ui,sans-serif">GET IT ON</text>
            <text x="36" y="28" fill="currentColor" class="text-offwhite" font-size="12" font-weight="600" font-family="system-ui,sans-serif">Google Play</text>
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>
