---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';

interface Props {
  dict: Dictionary;
  locale: string;
}

const { dict, locale } = Astro.props;
const c = dict.connect;
---

<section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
  <div class="glass flex flex-col items-start justify-between gap-6 rounded-3xl p-6 sm:flex-row sm:items-center sm:p-8">
    <div class="max-w-2xl">
      <span class="badge-roadmap">[{c.pageBadge}]</span>
      <h2 class="mt-3 font-display text-2xl font-bold sm:text-3xl">{c.sectionTitle}</h2>
      <p class="mt-2 text-sm text-slate-muted sm:text-base">{c.sectionBody}</p>
    </div>
    <a href={localizePath(locale, '/connect')} class="btn-outline shrink-0">
      {c.sectionLink}
    </a>
  </div>
</section>
