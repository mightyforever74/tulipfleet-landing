---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';

interface Props {
  dict: Dictionary;
  locale: string;
}

const { dict, locale } = Astro.props;
const c = dict.connect;
---

<section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
  <div class="glass flex flex-col items-start justify-between gap-8 rounded-3xl p-8 sm:flex-row sm:items-center sm:p-10">
    <div class="max-w-2xl">
      <span class="badge-roadmap">[{c.pageBadge}]</span>
      <h2 class="mt-4 font-display text-2xl font-bold tracking-tight text-offwhite sm:text-3xl">{c.sectionTitle}</h2>
      <p class="mt-4 text-base font-medium leading-relaxed text-navy-fog sm:text-lg">{c.sectionBody}</p>
    </div>
    <a href={localizePath(locale, '/connect')} class="btn-outline shrink-0 whitespace-nowrap">
      {c.sectionLink}
    </a>
  </div>
</section>
