---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';
import HeroMockup from './react/HeroMockup';

interface Props {
  dict: Dictionary;
  locale: string;
}

const { dict, locale } = Astro.props;
const signup = localizePath(locale, '/signup');
---

<section class="relative overflow-hidden pb-8 pt-16 sm:pb-10 sm:pt-20 lg:pb-12 lg:pt-24">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,87,34,0.14),transparent_55%),radial-gradient(ellipse_at_bottom_left,rgba(59,130,246,0.1),transparent_50%)]"
  />

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div class="motion-safe:animate-[fadeUp_0.7s_ease-out]">
      <div class="capsule-glow mb-6 w-fit">
        <span aria-hidden="true">🇪🇺</span>
        <span>{dict.hero.badge.replace('🇪🇺 ', '')}</span>
      </div>

      <h1 class="font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-[3.25rem]">
        <span class="text-gradient">{dict.hero.title}</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-muted sm:text-xl">
        {dict.hero.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={signup} class="btn-primary">{dict.hero.ctaTrial}</a>
        <a href="#pricing" class="btn-outline">{dict.hero.ctaPricing}</a>
      </div>
    </div>

    <div class="motion-safe:animate-[fadeUp_0.9s_ease-out] relative">
      <HeroMockup
        client:load
        title={dict.hero.mockupTitle}
        liveLabel={dict.hero.mockupLive}
        jobsLabel={dict.hero.mockupJobs}
        disclaimer={dict.hero.mockupDisclaimer}
        scenarios={dict.hero.scenarios}
      />
    </div>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-safe\:animate-\[fadeUp_0\.7s_ease-out\],
    .motion-safe\:animate-\[fadeUp_0\.9s_ease-out\] {
      animation: none !important;
    }
  }
</style>
