---
import type { Dictionary } from '../i18n';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section
  class="mt-4 border-y border-accent/20 bg-gradient-to-r from-navy via-[#1a1230]/60 to-navy"
  aria-label="Excel to TulipFleet"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
    <p class="max-w-xl font-display text-lg font-semibold text-offwhite sm:text-xl">
      {dict.excelStrip.headline}
    </p>
    <ul class="flex flex-wrap gap-3 text-sm text-slate-muted">
      {
        dict.excelStrip.points.map((point) => (
          <li class="rounded-full border border-accent/25 bg-accent/10 px-3 py-1.5 text-offwhite/90">
            {point}
          </li>
        ))
      }
    </ul>
  </div>
</section>
