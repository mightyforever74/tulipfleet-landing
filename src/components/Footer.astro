---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';

interface Props {
  locale: string;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
---

<footer class="mt-20 border-t border-white/10 bg-navy-deep/80">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div class="md:col-span-1">
      <p class="font-display text-lg font-bold">TulipFleet</p>
      <p class="mt-2 max-w-sm text-sm text-slate-muted">{dict.footer.tagline}</p>
      <p class="mt-4 space-y-1 text-sm text-slate-muted">
        <a class="block hover:text-accent-soft" href="mailto:info@tulipfleet.com">info@tulipfleet.com</a>
        <a class="block hover:text-accent-soft" href="mailto:privacy@tulipfleet.com">privacy@tulipfleet.com</a>
      </p>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{dict.footer.product}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-muted">
        <li>
          <a class="hover:text-offwhite" href={`${localizePath(locale, '/')}#features`}>
            {dict.footer.features}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/pricing')}>
            {dict.footer.pricing}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/signup')}>
            {dict.footer.signup}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/early-access')}>
            {dict.footer.earlyAccess}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{dict.footer.legal}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-muted">
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/privacy')}>
            {dict.footer.privacy}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/terms')}>
            {dict.footer.terms}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/imprint')}>
            {dict.footer.imprint}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/dpa')}>
            {dict.footer.dpa}
          </a>
        </li>
        <li>
          <a class="hover:text-offwhite" href={localizePath(locale, '/subprocessors')}>
            {dict.footer.subprocessors}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{dict.footer.company}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-muted">
        <li>
          <a class="hover:text-offwhite" href="mailto:info@tulipfleet.com">
            {dict.footer.contact}
          </a>
        </li>
        <li>
          <button
            type="button"
            class="hover:text-offwhite"
            data-cookie-preferences
          >
            {dict.footer.cookiePreferences}
          </button>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/5 px-4 py-4 text-center text-xs text-slate-muted sm:px-6">
    {dict.footer.copyright}
  </div>
</footer>

<script>
  document.querySelectorAll('[data-cookie-preferences]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('tf-consent-open'));
    });
  });
</script>
