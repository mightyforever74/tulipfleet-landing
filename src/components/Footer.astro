---
import type { Dictionary } from '../i18n';
import { localizePath } from '../lib/env';

interface Props {
  locale: string;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const link = 'text-navy-fog transition hover:text-offwhite';
---

<footer class="mt-24 border-t border-navy-line bg-navy-ink">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-4 md:gap-16">
    <div class="md:col-span-1">
      <p class="font-display text-lg font-bold text-offwhite">TulipFleet</p>
      <p class="mt-3 max-w-sm text-sm font-medium leading-relaxed text-navy-fog">{dict.footer.tagline}</p>
      <p class="mt-6 space-y-2 text-sm">
        <a class={`block ${link}`} href="mailto:info@tulipfleet.com">info@tulipfleet.com</a>
        <a class={`block ${link}`} href="mailto:privacy@tulipfleet.com">privacy@tulipfleet.com</a>
      </p>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{dict.footer.product}</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li>
          <a class={link} href={`${localizePath(locale, '/')}#features`}>
            {dict.footer.features}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/pricing')}>
            {dict.footer.pricing}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/signup')}>
            {dict.footer.signup}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/early-access')}>
            {dict.footer.earlyAccess}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/connect')}>
            {dict.footer.connect}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{dict.footer.legal}</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li>
          <a class={link} href={localizePath(locale, '/privacy')}>
            {dict.footer.privacy}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/terms')}>
            {dict.footer.terms}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/imprint')}>
            {dict.footer.imprint}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/dpa')}>
            {dict.footer.dpa}
          </a>
        </li>
        <li>
          <a class={link} href={localizePath(locale, '/subprocessors')}>
            {dict.footer.subprocessors}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="font-display text-sm font-semibold text-offwhite">{dict.footer.company}</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li>
          <a class={link} href="mailto:info@tulipfleet.com">
            {dict.footer.contact}
          </a>
        </li>
        <li>
          <button
            type="button"
            class={link}
            data-cookie-preferences
          >
            {dict.footer.cookiePreferences}
          </button>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-line px-4 py-8 text-center text-xs font-medium text-navy-fog sm:px-6">
    {dict.footer.copyright}
  </div>
</footer>

<script>
  document.querySelectorAll('[data-cookie-preferences]').forEach((el) => {
    el.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('tf-consent-open'));
    });
  });
</script>
