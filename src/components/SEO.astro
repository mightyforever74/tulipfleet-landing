---
import { localizePath } from '../lib/env';
import { buildJsonLd, jsonLdKind } from '../lib/jsonld';
import { hreflangCluster, ogLocaleAlternates, shouldEmitHreflang } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  locale: string;
  path: string;
  siteName: string;
  ogLocale: string;
  noindex?: boolean;
  active?: boolean;
  offerUnitText?: string;
}

const {
  title,
  description,
  locale,
  path,
  siteName,
  ogLocale,
  noindex = false,
  active = true,
  offerUnitText = 'per vehicle per month',
} = Astro.props;
const site = Astro.site ?? new URL('https://tulipfleet.com');
const canonicalPath = path.startsWith('/') ? path : `/${path}`;
const canonical = new URL(localizePath(locale, canonicalPath), site).href;
const ogImage = new URL('/og-default.svg', site).href;
const alternates = shouldEmitHreflang({ locale, path: canonicalPath, noindex, active })
  ? hreflangCluster({ path: canonicalPath, site })
  : [];
const jsonLdBlocks = buildJsonLd({
  kind: jsonLdKind(canonicalPath, { active, noindex }),
  site,
  canonical,
  title,
  description,
  locale,
  unitText: offerUnitText,
});
const ogAlternates = ogLocaleAlternates(ogLocale);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
{
  ogAlternates.map((tag) => (
    <meta property="og:locale:alternate" content={tag} />
  ))
}
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}
